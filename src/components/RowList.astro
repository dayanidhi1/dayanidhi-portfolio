---
import { path } from "../paths";

interface Props {
  heading?: "h2" | "h3";
  items: Array<{
    title: string;
    text?: string;
    outcome?: string;
    slug?: string;
    date?: string;
    excerpt?: string;
  }>;
}

const { items, heading: Heading = "h3" } = Astro.props;
---
<ul class="rows">
  {items.map((item) => (
    <li>
      {item.date && <p class="mb-1 text-sm text-muted">{item.date}</p>}
      <Heading class="row-title">
        {item.slug
          ? <a class="text-link" href={path(`blogs/${item.slug}/`)}>{item.title}</a>
          : item.title}
      </Heading>
      {item.outcome && <p class="mt-1 text-sm font-semibold text-gold">{item.outcome}</p>}
      <p class="mt-1 leading-relaxed">{item.text ?? item.excerpt}</p>
    </li>
  ))}
</ul>
