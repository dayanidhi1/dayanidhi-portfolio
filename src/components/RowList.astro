---
import { path } from "../paths";

interface Props {
  heading?: "h2" | "h3";
  items: Array<{
    title: string;
    text?: string;
    outcome?: string;
    metrics?: { value: string; label: string }[];
    slug?: string;
    link?: string;
    date?: string;
    excerpt?: string;
  }>;
}

const { items, heading: Heading = "h3" } = Astro.props;
---
<ul class="rows">
  {items.map((item) => (
    <li>
      {item.date && <p class="mb-1 text-sm text-muted">{item.date}</p>}
      <Heading class="row-title" style="font-weight:600;">
        {item.link ? (
          <a class="text-link" href={item.link} target="_blank" rel="noopener">{item.title}</a>
        ) : item.slug ? (
          <a class="text-link" href={path(`/blogs/${item.slug}/`)}>{item.title}</a>
        ) : (
          item.title
        )}
      </Heading>
      {item.metrics ? (
        <div style="display:flex; gap:10px; flex-wrap:wrap; margin:12px 0 14px;">
          {item.metrics.map((m) => (
            <div style="background:#16233A; border:1px solid rgba(212,175,55,0.35); border-radius:8px; padding:10px 14px; min-width:120px;">
              <div style="font-size:24px; font-weight:700; color:#E8C86A; line-height:1;">{m.value}</div>
              <div style="font-size:12px; font-weight:400; color:#AAB8D0; margin-top:4px;">{m.label}</div>
            </div>
          ))}
        </div>
      ) : item.outcome ? (
        <p class="mt-1 text-sm font-semibold text-gold">{item.outcome}</p>
      ) : null}
      <p class="mt-1 leading-relaxed">{item.text ?? item.excerpt}</p>
    </li>
  ))}
</ul>
