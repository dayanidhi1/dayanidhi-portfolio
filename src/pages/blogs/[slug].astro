---
import Layout from "../../components/Layout.astro";
import { DATA, UI } from "../../data";
import { path } from "../../paths";

export function getStaticPaths() {
  return DATA.blogs.map((blog) => ({ params: { slug: blog.slug }, props: { blog } }));
}

const { blog } = Astro.props;
---
<Layout title={blog.title} description={blog.excerpt} article>
  <article class="band">
    <div class="wrap">
      <a class="text-link" href={path("blogs/")}>{UI.backToBlogs}</a>
      <div class="mt-8 max-w-3xl">
        <p class="eyebrow mb-3">{blog.date}</p>
        <h1 class="heading">{blog.title}</h1>
        <p class="text-lg leading-relaxed">{blog.excerpt}</p>
      </div>
    </div>
  </article>
</Layout>
